# For local development, copy this file to .env and replace the placeholder.
ZENARA_ENV=development
ZENARA_SECRET_KEY=replace-with-a-random-value
ZENARA_DEBUG=0

# Optional: the default is instance/zenara.db.
# DATABASE_URL=sqlite:///zenara.db

# Use Redis for shared rate limits when deploying multiple workers.
# ZENARA_RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
